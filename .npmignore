# Exclude all top-level hidden files and directories
/.*

# Exclude tarballs generated by `npm pack`
/*.tgz

# Test files
__mocks__
__tests__

# Dev config / tooling
/babel.config.js
/eslint.config.js
/tsconfig*.json
/jest.config.cjs
/typedoc.json
/CLAUDE.md
/AGENTS.md
/scripts/

# Repository docs. The consumer guides in docs/ ship, because the README links to them;
# the glossary, ADRs and agent docs stay out. Put any new internal doc in a folder listed here.
/GLOSSARY.md
/docs/adr/
/docs/agents/

# iOS XCTest sources (the podspec only compiles ios/*.swift)
/ios/Tests/

# Android build artifacts and Gradle caches
/android/.gradle/
/android/src/androidTest/
/android/src/test/
/android/build/

# Example app
/example/
