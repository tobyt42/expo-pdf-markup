{
  "name": "@tobyt/expo-pdf-markup",
  "version": "2.0.0",
  "description": "An Expo module for displaying and annotating PDFs",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('build', { recursive: true, force: true })\"",
    "lint": "eslint src",
    "lint:swift": "swiftlint lint ios/",
    "lint:kotlin": "ktlint 'android/src/**/*.kt'",
    "format": "node ./node_modules/prettier/bin/prettier.cjs --write \"src/**/*.{ts,tsx}\"",
    "format:check": "node ./node_modules/prettier/bin/prettier.cjs --check \"src/**/*.{ts,tsx}\"",
    "format:swift": "swiftformat ios/",
    "format:swift:check": "swiftformat --lint ios/",
    "format:kotlin": "ktlint --format 'android/src/**/*.kt'",
    "format:kotlin:check": "ktlint 'android/src/**/*.kt'",
    "test": "jest",
    "test:swift": "bash scripts/test-swift.sh",
    "test:kotlin": "cd example/android && ./gradlew :tobyt-expo-pdf-markup:testDebugUnitTest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "qa:ts": "npm run typecheck && npm run typecheck:tests && npm run format && npm run lint && npm run test",
    "qa:ios": "npm run format:swift && npm run lint:swift && npm run test:swift",
    "qa:android": "npm run format:kotlin && npm run lint:kotlin && npm run test:kotlin",
    "qa": "npm run qa:ts && npm run qa:ios && npm run qa:android",
    "prepublishOnly": "npm run clean && npm run build",
    "open:ios": "xed example/ios",
    "open:android": "open -a \"Android Studio\" example/android",
    "docs": "typedoc",
    "changeset": "changeset",
    "changeset:add": "changeset add",
    "changeset:version": "changeset version",
    "release": "bash scripts/release.sh"
  },
  "keywords": [
    "react-native",
    "expo",
    "@tobyt/expo-pdf-markup",
    "ExpoPdfMarkup"
  ],
  "repository": "https://github.com/tobyt42/expo-pdf-markup",
  "bugs": {
    "url": "https://github.com/tobyt42/expo-pdf-markup/issues"
  },
  "author": "Toby Terhoeven <toby@terhoeven.dev> (https://github.com/tobyt42)",
  "license": "MIT",
  "homepage": "https://github.com/tobyt42/expo-pdf-markup#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@react-native/jest-preset": "^0.88.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "expo": "~58.0.26",
    "expo-modules-core": "~58.1.0",
    "globals": "^16.5.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-expo": "~58.0.15",
    "pdfjs-dist": "^6.1.200",
    "prettier": "^3.9.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-web": "^0.21.4",
    "typedoc": "^0.28.17",
    "typescript": "~5.9.3"
  },
  "peerDependencies": {
    "expo": "*",
    "pdfjs-dist": ">=3.0.0",
    "react": "*",
    "react-native": "*"
  },
  "peerDependenciesMeta": {
    "pdfjs-dist": {
      "optional": true
    }
  }
}
