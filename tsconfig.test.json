// Type-checks the test suites, including the compile-time type tests, which
// Jest (Babel) and the library build (tests excluded) never type-check.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["jest", "node"]
  },
  "include": ["./src"],
  "exclude": []
}
