// Type-checks the test suites, including the compile-time type tests, which
// Jest (Babel) and the library build (tests excluded) never type-check. Also
// type-checks the release scripts (scripts/release/), which Node runs directly
// with type stripping, so they import each other with `.ts` extensions.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["jest", "node"]
  },
  "include": ["./src", "./scripts/release"],
  "exclude": []
}
